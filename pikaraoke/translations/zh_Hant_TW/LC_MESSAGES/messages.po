msgstr "加入"

#. Primary button in the identity dialog when saving profile changes.
#. Label on button which saves the changes.
#: templates/base.html:48 templates/base.html:821 templates/edit.html:167
msgid "Save"
msgstr "儲存"

#. Help under the name field when editing a profile, warning that saving
#. renames the singer everywhere - queue, play history and favourites all
#. move.
#: templates/base.html:50
msgid "Editing your name renames you everywhere."
msgstr "修改名字後，點的歌、演唱紀錄和最愛都會改成新名字。"

#. Toast confirming a singer renamed themselves. {name} is the new name.
#: templates/base.html:52
#, python-brace-format
