msgstr "你現在的名字是 {name}"

#. Quiet button in the profile dialog that clears the name on this device.
#. Button which logs the user out of admin mode.
#: templates/base.html:54 templates/settings.html:796
msgid "Log out"
msgstr "登出"

#. Label on the name field in the identity dialog.
#. Button which sorts the songs by name.
#. Singer list column header for the singer's name.
#: templates/base.html:56 templates/files.html:517 templates/singers.html:500
msgid "Name"
msgstr "名稱"

#. Hint under the name field noting the name is public.
#: templates/base.html:58
msgid "This name is visible to everyone."
msgstr "大家都會看到這個名字。"

#. Placeholder shown in the empty name field of the identity dialog.
#: templates/base.html:60
msgid "Your name"
msgstr "你的名字"

#. Confirmation prompt to clear entire queue. User must type ok to confirm
#: templates/base.html:62
msgid "Are you sure you want to clear the ENTIRE queue? Type ok to continue"
msgstr "確定要清空整個待唱清單嗎？請輸入 ok 繼續"

#. Confirmation dialog when permanently deleting a song file from the library
#: templates/base.html:64
msgid "Are you sure you want to delete this song from the library?"
msgstr "確定要從歌曲庫刪除這首歌嗎？"

#. Label showing the number of semitones for pitch shift. {value} is replaced
#. with a number like +3 or -2.
#: templates/base.html:66
#, python-brace-format
msgid "{value} semitones"
msgstr "{value} Key"

#. Confirmation dialog when changing the key/pitch of a song. {label} is
#. replaced with a label like "+3 semitones".
#: templates/base.html:68
#, python-brace-format
msgid "Transpose this song: {label}?"
msgstr "要把這首歌調成 {label} 嗎？"

#. Toast confirming the key/pitch change was applied. {label} is replaced with
#. a label like "+3 semitones".
#: templates/base.html:70
#, python-brace-format
msgid "Key changed: {label}"
msgstr "已調整：{label}"

#. Confirmation dialog when restarting the currently playing track.
#: templates/base.html:72
msgid "Are you sure you want to restart this track?"
msgstr "確定要從頭重唱這首歌嗎？"

#. Informational tooltip explaining what a semitone is.
#: templates/base.html:74
msgid ""
"A semitone is also known as a half-step. It is the smallest interval used in"
" classical Western music, equal to a twelfth of an octave or half a tone."
msgstr "Key 就是半音，是西洋音樂中最小的音程，等於一個八度的十二分之一。KTV 說的「升一個 Key」就是升高一個半音。"

#. Confirmation dialog when expanding the filesystem on Raspberry Pi, which
#. triggers a reboot.
#: templates/base.html:76
msgid ""
"Are you sure you want to expand the filesystem? This will reboot your "
"raspberry pi."
msgstr "確定要擴充儲存空間嗎？樹莓派會重新開機。"

#. Generic error prefix shown before an error message.
#: templates/base.html:78
msgid "Error"
msgstr "錯誤"

#. Row-options menu item which marks a song as one of the singer's favourites.
#: templates/base.html:80
msgid "Add to favourites"
msgstr "加入最愛"

#. Row-options menu item which removes a song from the singer's favourites.
#: templates/base.html:82
msgid "Remove from favourites"
msgstr "從最愛移除"

#. Toast confirming a song was added to favourites. {title} is the song name.
#: templates/base.html:84
#, python-brace-format
msgid "Added to favourites: {title}"
msgstr "已加入最愛：{title}"

#. Toast confirming a song was removed from favourites. {title} is the song
#. name.
#: templates/base.html:86
#, python-brace-format
msgid "Removed from favourites: {title}"
msgstr "已從最愛移除：{title}"

