#. Message shown after starting the yt-dlp update.
#: routes/admin.py:105
msgid "Updating yt-dlp! Should take a minute or two... "
msgstr "正在更新 yt-dlp，大約需要一兩分鐘..."

#. Message shown after quitting pikaraoke.
#: routes/admin.py:126
msgid "Exiting pikaraoke now!"
msgstr "正在關閉 PiKaraoke！"

#. Message shown after shutting down the system.
#: routes/admin.py:134
msgid "Shutting down system now!"
msgstr "正在關機！"

#. Message shown when the system refuses to let pikaraoke shut it down.
#: routes/admin.py:137
msgid ""
"Shutdown failed: pikaraoke does not have permission to power off this "
"system."
msgstr "關機失敗：PiKaraoke 沒有權限關閉這台電腦。"

#. Message shown after rebooting the system.
#: routes/admin.py:146
msgid "Rebooting system now!"
msgstr "正在重新開機！"

#. Message shown when the system refuses to let pikaraoke reboot it.
#: routes/admin.py:149
msgid ""
"Reboot failed: pikaraoke does not have permission to restart this system."
msgstr "重新開機失敗：PiKaraoke 沒有權限重新啟動這台電腦。"

#. Message shown after expanding the filesystem.
#: routes/admin.py:159
msgid "Expanding filesystem and rebooting system now!"
msgstr "正在擴充儲存空間並重新開機！"

#. Message shown when the system refuses to let pikaraoke expand the
#. filesystem.
#: routes/admin.py:161
msgid ""
"Expand failed: pikaraoke does not have permission to resize the filesystem."
msgstr "擴充失敗：PiKaraoke 沒有權限調整檔案系統大小。"

#. Message shown after trying to expand the filesystem on a non-raspberry pi
#. device.
#: routes/admin.py:165
msgid "Cannot expand fs on non-raspberry pi devices!"
msgstr "只有樹莓派才能擴充儲存空間！"

#. Message shown after logging in as admin successfully
#: routes/admin.py:177
msgid "Admin mode granted!"
msgstr "已切換為管理員模式！"

#. Message shown after too many failed admin login attempts.
#: routes/admin.py:182
#, python-format
msgid "Too many attempts. Try again in %(seconds)d seconds."
msgstr "嘗試次數太多，請 %(seconds)d 秒後再試。"

#. Message shown after failing to login as admin
#: routes/admin.py:189
msgid "Incorrect admin password!"
msgstr "管理員密碼錯誤！"

#. Message shown after setting a new admin password.
#: routes/admin.py:206
msgid "Admin password set. Other devices will need to log in again."
msgstr "管理員密碼已設定，其他裝置需要重新登入。"

#. Message shown after clearing the admin password, making everyone an admin.
#: routes/admin.py:209
msgid "Admin password cleared. Everyone is an admin again."
msgstr "管理員密碼已清除，現在每個人都是管理員。"

#. Message shown after logging out as admin successfully
#: routes/admin.py:221
msgid "Logged out of admin mode!"
msgstr "已登出管理員模式！"

#. Title of the button to accept the suggested name
#: routes/batch_song_renamer.py:136
msgid "Accept suggested name"
msgstr "使用建議名稱"

#. Title of the files page.
#: routes/batch_song_renamer.py:144
msgid "Batch Song Renamer"
msgstr "批次改歌名"

#: routes/batch_song_renamer.py:237
#, python-format
msgid "Error: Can't edit this song because it is queued or playing: %s"
msgstr "錯誤：這首歌已被點播或正在播放，無法編輯：%s"

#: routes/batch_song_renamer.py:244
#, python-format
msgid "Error renaming file: '%s' to '%s', Filename already exists"
msgstr "改名失敗：「%s」改成「%s」，檔名已經存在"

#: routes/batch_song_renamer.py:253 routes/files.py:342
msgid ""
"This song started playing while you were editing it. Rename it when it "
"finishes."
msgstr "你編輯時這首歌開始播放了，請等播完再改名。"

#. Message shown after a rename failed. Followed by the system error.
#: routes/batch_song_renamer.py:258 routes/files.py:348
#, python-format
msgid "Error renaming file: %s"
msgstr "改名失敗：%s"

#. Title of the page listing the songs already on this machine.
#. Navigation link for the page listing songs already on this machine.
#: routes/files.py:217 templates/base.html:686 templates/base.html:689
msgid "Songs"
msgstr "歌曲"

#. Message shown after trying to delete a song that is queued or playing.
#: routes/files.py:248
msgid "Error: Can't delete this song because it is queued or playing"
msgstr "錯誤：這首歌已被點播或正在播放，無法刪除"

#. Message shown after a delete failed. Followed by the system error.
#: routes/files.py:257
#, python-format
msgid "Error deleting file: %s"
msgstr "刪除檔案失敗：%s"

#: routes/files.py:261
#, python-format
msgid "Song deleted: %s"
msgstr "已刪除歌曲：%s"

#. Title of the page where a song can be renamed.
#: routes/files.py:273
msgid "Rename Song"
msgstr "修改歌名"

#. Message shown after trying to rename the song that is playing.
#: routes/files.py:295
msgid "This song is playing. Rename it when it finishes."
msgstr "這首歌正在播放，請等播完再改名。"

#. Message shown after saving the rename page with an empty name.
#: routes/files.py:316
msgid "Enter a name for this song."
msgstr "請輸入歌名。"

#: routes/files.py:322
msgid ""
"This song is no longer in the library. It may have been renamed or deleted "
"from another device."
msgstr "這首歌已不在歌曲庫中，可能已在其他裝置上被改名或刪除。"

#. Message shown after trying to rename a song to a name already in use.
#: routes/files.py:334
#, python-format
msgid "A song called '%s' already exists."
msgstr "已經有一首叫「%s」的歌了。"

#. Message shown after renaming a file.
#: routes/files.py:353
#, python-format
msgid "Renamed file: %s to %s"
msgstr "已改名：%s 改成 %s"

#. Title of the home page, which shows the song playing now.
#: routes/home.py:26 templates/home.html:89
msgid "Now Playing"
msgstr "正在唱"

#. Title of the page with the QR code to join and the system information.
