    "/api/history/singers": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "session",
            "description": "Session UUID filter",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Rows to return (1-500)",
            "schema": {
              "type": "integer",
              "default": null,
              "minimum": 1,
              "maximum": 500,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "completed_only",
            "description": "Count only songs sung through, for the singer lists",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Performer names with play counts, most active first.",
        "description": "Unscoped for the singer auto-complete; scoped to a session for its singer\nlist. Only the auto-complete leaves completed_only off: it is a directory of\nwho sings here, so dropping someone who skipped their only song would just\nmean the host typing the name out again.",
        "tags": [
          "sessions_api"
        ]
      }
    },
