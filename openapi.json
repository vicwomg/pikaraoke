{
  "security": [
    {
      "adminSession": []
    }
  ],
  "paths": {
    "/api/auth": {
      "get": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Report whether the caller is an admin, and whether a password is wanted at all.",
        "tags": [
          "auth_api"
        ],
        "security": []
      },
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "summary": "Exchange the admin password for a session cookie.",
        "description": "The cookie comes back in `Set-Cookie`, which browsers hide from scripts, so\nthis console cannot show it. Call a host-only endpoint to confirm it worked.",
        "tags": [
          "auth_api"
        ],
        "security": []
      }
    },
    "/api/get_queue": {
      "get": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Get the current song queue.",
        "tags": [
          "queue_api"
        ],
        "security": []
      }
    },
    "/api/queue/addrandom/{amount}": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Add random songs to the queue.",
        "description": "The queue redraws itself off `queue_update`, so only the empty-handed case\nneeds saying.",
        "tags": [
          "queue_api"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "amount",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "/api/queue/reorder": {
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ReorderForm"
              }
            }
          }
        },
        "summary": "Handle drag-and-drop reordering of the queue.",
        "tags": [
          "queue_api"
        ]
      }
    },
    "/api/queue/edit": {
      "post": {
        "parameters": [
          {
            "in": "query",
            "name": "action",
            "description": "Queue edit action to perform",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "song",
            "description": "Path to the song file (required unless action is 'clear')",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Edit queue items (admin only).",
        "tags": [
          "queue_api"
        ]
      }
    },
    "/api/enqueue": {
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueForm"
              }
            }
          }
        },
        "summary": "Add a song to the queue.",
        "tags": [
          "queue_api"
        ],
        "security": []
      }
    },
    "/api/queue/downloads": {
      "get": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Get the status of current and pending downloads.",
        "tags": [
          "queue_api"
        ],
        "security": []
      }
    },
    "/api/queue/downloads/errors/{error_id}": {
      "delete": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Remove a download error from the list.",
        "tags": [
          "queue_api"
        ],
        "security": []
      },
      "parameters": [
        {
          "in": "path",
          "name": "error_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/queue/downloads/errors/{error_id}/retry": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Re-queue a failed download.",
        "tags": [
          "queue_api"
        ],
        "security": []
      },
      "parameters": [
        {
          "in": "path",
          "name": "error_id",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/preview": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "url",
            "description": "YouTube video URL to preview",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Get a direct stream URL for previewing a YouTube video.",
        "tags": [
          "search_api"
        ],
        "security": []
      }
    },
    "/api/download": {
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadBody"
              }
            }
          }
        },
        "summary": "Download a video from YouTube.",
        "tags": [
          "search_api"
        ],
        "security": []
      }
    },
    "/api/change_preferences": {
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ChangePreferenceForm"
              }
            }
          }
        },
        "summary": "Change a user preference setting.",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/clear_preferences": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Reset all preferences to defaults.",
        "description": "Answers `[success, message]` like `change_preferences` beside it. The caller\nre-renders /info, whose controls are server-rendered and listen for nothing.",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/skip": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Skip the currently playing song.",
        "tags": [
          "controller"
        ]
      }
    },
    "/api/pause": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Toggle pause/resume playback.",
        "tags": [
          "controller"
        ]
      }
    },
    "/api/transpose/{semitones}": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Transpose (pitch shift) the current song.",
        "tags": [
          "controller"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "semitones",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/restart": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Restart the current song from the beginning.",
        "tags": [
          "controller"
        ]
      }
    },
    "/api/volume/{volume}": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Set the playback volume.",
        "tags": [
          "controller"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "volume",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/vol_up": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Increase volume by 10%.",
        "tags": [
          "controller"
        ]
      }
    },
    "/api/vol_down": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Decrease volume by 10%.",
        "tags": [
          "controller"
        ]
      }
    },
    "/api/library_stats": {
      "get": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Return song count for the admin dashboard.",
        "tags": [
          "library"
        ]
      }
    },
    "/api/sync_library": {
      "post": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Trigger a background library scan.",
        "tags": [
          "library"
        ]
      }
    },
    "/api/now_playing": {
      "get": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Get current playback status.",
        "tags": [
          "now_playing"
        ],
        "security": []
      }
    },
    "/api/metadata/auto-format": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "filename",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Apply regex_tidy to a filename and return the formatted result.",
        "tags": [
          "metadata"
        ]
      }
    },
    "/api/metadata/suggest-names": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "filename",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 5
            },
            "required": false
          },
          {
            "in": "query",
            "name": "country",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Search for track suggestions matching a filename.",
        "tags": [
          "metadata"
        ]
      }
    },
    "/api/history/singers": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "session",
            "description": "Session UUID filter",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Rows to return (1-500)",
            "schema": {
              "type": "integer",
              "default": null,
              "minimum": 1,
              "maximum": 500,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "completed_only",
            "description": "Count only songs sung through, for the singer lists",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Performer names with play counts, most active first.",
        "description": "Unscoped for the singer auto-complete; scoped to a session for its singer\nlist. Only the auto-complete leaves completed_only off: it is a directory of\nwho sings here, so dropping someone who skipped their only song would just\nmean the host typing the name out again.",
        "tags": [
          "sessions_api"
        ]
      }
    },
    "/api/history/plays": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "session",
            "description": "Session UUID filter",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Rows to return (1-500)",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 500
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "required": false
          },
          {
            "in": "query",
            "name": "sort",
            "description": "played_at, performer or song",
            "schema": {
              "type": "string",
              "default": "played_at"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "direction",
            "description": "asc or desc",
            "schema": {
              "type": "string",
              "default": "desc"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "include_skipped",
            "description": "Show songs nobody sang through",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "performer",
            "description": "Performer name filter, case-insensitive",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "song",
            "description": "Song title filter",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          },
          {
            "in": "query",
            "name": "youtube_id",
            "description": "Song's YouTube id, when it has one",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Paginated play log, newest first, optionally scoped to one session.",
        "tags": [
          "sessions_api"
        ],
        "security": []
      }
    },
    "/api/history/plays/{play_id}": {
      "delete": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Delete a single play from the log.",
        "tags": [
          "sessions_api"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "play_id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "/api/history/sessions": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Rows to return (1-500)",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 500
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "required": false
          },
          {
            "in": "query",
            "name": "include_unnamed",
            "description": "Include auto-started sessions the host never named",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Session list with play counts, plus the currently active session.",
        "tags": [
          "sessions_api"
        ]
      },
      "post": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionForm"
              }
            }
          }
        },
        "summary": "Start a new session, closing any that is still open.",
        "tags": [
          "sessions_api"
        ]
      }
    },
    "/api/history/sessions/{session_uuid}": {
      "put": {
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSessionForm"
              }
            }
          }
        },
        "summary": "End, activate or rename a session. The schema rejects any other action.",
        "tags": [
          "sessions_api"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "session_uuid",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "delete": {
        "responses": {
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Delete a session and all of its plays.",
        "tags": [
          "sessions_api"
        ]
      }
    },
    "/api/history": {
      "delete": {
        "parameters": [
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "session"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "session",
            "description": "UUID when scope=session",
            "schema": {
              "type": "string",
              "default": null,
              "nullable": true
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Erase play history: one session's plays, or everything on record.",
        "tags": [
          "sessions_api"
        ]
      }
    },
    "/api/history/export/{session_uuid}": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "csv (spreadsheet) or txt (human-readable list)",
            "schema": {
              "type": "string",
              "default": "csv",
              "enum": [
                "csv",
                "txt"
              ]
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Download a session's plays as CSV or a human-readable text list.",
        "tags": [
          "sessions_api"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "session_uuid",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  },
  "info": {
    "title": "PiKaraoke API",
    "version": "1.23.0"
  },
  "tags": [
    {
      "name": "auth_api",
      "description": ""
    },
    {
      "name": "queue_api",
      "description": ""
    },
    {
      "name": "search_api",
      "description": ""
    },
    {
      "name": "preferences",
      "description": ""
    },
    {
      "name": "controller",
      "description": ""
    },
    {
      "name": "library",
      "description": ""
    },
    {
      "name": "now_playing",
      "description": ""
    },
    {
      "name": "metadata",
      "description": ""
    },
    {
      "name": "sessions_api",
      "description": ""
    }
  ],
  "openapi": "3.0.2",
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code"
          },
          "status": {
            "type": "string",
            "description": "Error name"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "errors": {
            "type": "object",
            "description": "Errors",
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      },
      "PaginationMetadata": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of items."
          },
          "total_pages": {
            "type": "integer",
            "description": "Total number of pages."
          },
          "first_page": {
            "type": "integer",
            "description": "First available page number."
          },
          "last_page": {
            "type": "integer",
            "description": "Last available page number."
          },
          "page": {
            "type": "integer",
            "description": "Current page number."
          },
          "previous_page": {
            "type": "integer",
            "description": "Previous page number."
          },
          "next_page": {
            "type": "integer",
            "description": "Next page number."
          }
        },
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "admin_password": {
            "type": "string",
            "description": "The admin password"
          }
        },
        "required": [
          "admin_password"
        ],
        "additionalProperties": false
      },
      "ReorderForm": {
        "type": "object",
        "properties": {
          "old_index": {
            "type": "integer",
            "description": "Current index of the item to move"
          },
          "new_index": {
            "type": "integer",
            "description": "Target index to move the item to"
          }
        },
        "required": [
          "new_index",
          "old_index"
        ],
        "additionalProperties": false
      },
      "EnqueueForm": {
        "type": "object",
        "properties": {
          "song_to_add": {
            "type": "string",
            "description": "Path to the song file"
          },
          "song_added_by": {
            "type": "string",
            "default": "",
            "description": "Name of the user adding the song"
          }
        },
        "required": [
          "song_to_add"
        ],
        "additionalProperties": false
      },
      "DownloadBody": {
        "type": "object",
        "properties": {
          "song_url": {
            "type": "string",
            "description": "YouTube URL to download"
          },
          "song_added_by": {
            "type": "string",
            "description": "Name of the user requesting the download"
          },
          "song_title": {
            "type": "string",
            "description": "Display title for the song"
          },
          "queue": {
            "type": "boolean",
            "default": false,
            "description": "Whether to queue the song after download"
          }
        },
        "required": [
          "song_added_by",
          "song_title",
          "song_url"
        ],
        "additionalProperties": false
      },
      "ChangePreferenceForm": {
        "type": "object",
        "properties": {
          "pref": {
            "type": "string",
            "description": "Name of the preference to change"
          },
          "val": {
            "type": "string",
            "description": "New value for the preference"
          }
        },
        "required": [
          "pref",
          "val"
        ],
        "additionalProperties": false
      },
      "StartSessionForm": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "description": "Session name"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "UpdateSessionForm": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "rename",
              "end",
              "activate"
            ]
          },
          "name": {
            "type": "string",
            "default": null,
            "maxLength": 60,
            "description": "New name when renaming",
            "nullable": true
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "DEFAULT_ERROR": {
        "description": "Default error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UNPROCESSABLE_ENTITY": {
        "description": "Unprocessable Entity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Session cookie issued by POST /api/auth."
      }
    }
  }
}